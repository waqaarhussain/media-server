[Unit]
Description=@APP@ movie media service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment=HOME=@HOME@
ExecStart=/opt/@APP@/@APP@ -nobrowser -data=/var/lib/@LOWER@/
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0002

[Install]
WantedBy=multi-user.target
